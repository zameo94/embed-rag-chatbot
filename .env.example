# Public base URL of the jac-rag API the widget calls from the customer's
# browser. It is baked into the bundle at build time (Vite exposes VITE_* to the
# app). Must be reachable by the visitor's browser, not an internal Docker name.
VITE_WIDGET_API_URL=http://localhost:8000
# Embed key used by the demo page served at "/". Optional: if unset, the page
# shows a hint instead. Get it from the CMS (Settings -> Embed keys).
WIDGET_EMBED_KEY=
# Host port for the demo static server (nginx) that serves dist/.
WIDGET_PORT=8080
